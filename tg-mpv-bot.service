[Unit]
Description=tg-mpv-bot — Telegram mpv remote control
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# %h = the user's home directory (systemd specifier) — adjust the repo path if
# you cloned elsewhere. The .venv comes from `uv sync`.
WorkingDirectory=%h/Projects/tg-mpv-bot
ExecStart=%h/Projects/tg-mpv-bot/.venv/bin/python3 bot.py
Restart=on-failure
RestartSec=5
# BOT_TOKEN / ALLOWED_USERS live here, outside the repo:
EnvironmentFile=%h/.config/environment.d/99-tg-mpv-bot.conf
Environment=DISPLAY=:0
# WM glue lives in hooks, not the bot. i3-msg finds its socket via X11 —
# never hardcode I3SOCK (the path embeds i3's PID and goes stale on reboot).
Environment="PRE_PLAY_HOOK=i3-msg workspace 10"
# URL playback: Firefox cookies for gated Instagram/Facebook ONLY — never
# global (logged-in YouTube cookies make yt-dlp hang on bot checks).
Environment=YTDL_COOKIES_BROWSER=firefox
# force-ipv4: this host's IPv6 path to YouTube TLS-stalls (flagged/limited),
# while IPv4 goes through the hysteria2 TUN — the same proven path the
# browser uses for YouTube daily. (v4 is also universally supported, unlike
# the force-ipv6 experiment that broke v4-only SoundCloud.)
# extractor-args: lean single-client extraction, skip the slow webpage —
# measured 22s vs a 60s timeout. Remove it first if YouTube changes break it.
Environment=YTDL_OPTIONS=force-ipv4,extractor-args=youtube:player_client=android_vr;player_skip=webpage
# Refresh the yt-dlp nightly weekly, before YouTube breakage bites.
Environment=YTDL_UPDATE_DAYS=7
Environment=YTDL_SUB_LANGS=en.*,ru.*
# Non-YouTube playback goes through the local nekoray mixed proxy: the ISP
# IPv6 line can't reach several media CDNs, and probe + mpv must share one
# egress anyway (IP-locked CDN URLs).
Environment=MEDIA_PROXY=http://127.0.0.1:2080
# The user manager's inherited PATH can be minimal; ensure the std bin dirs
# are present, plus ~/.local/bin so /mpv_update_ytdlp finds uv.
Environment=PATH=%h/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

[Install]
WantedBy=default.target

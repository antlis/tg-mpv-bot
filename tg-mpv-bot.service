[Unit]
Description=tg-mpv-bot — Telegram mpv remote control
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# %h = the user's home directory (systemd specifier) — adjust the repo path if
# you cloned elsewhere.
WorkingDirectory=%h/Projects/tg-mpv-bot
ExecStart=%h/Projects/tg-mpv-bot/venv/bin/python3 bot.py
Restart=on-failure
RestartSec=5
# BOT_TOKEN / ALLOWED_USERS live here, outside the repo:
EnvironmentFile=%h/.config/environment.d/99-tg-mpv-bot.conf
Environment=DISPLAY=:0
# WM glue lives in hooks, not the bot. i3-msg finds its socket via X11 —
# never hardcode I3SOCK (the path embeds i3's PID and goes stale on reboot).
Environment="PRE_PLAY_HOOK=i3-msg workspace 10"
# URL playback: Firefox cookies for gated Instagram/Facebook ONLY — never
# global (logged-in YouTube cookies make yt-dlp hang on bot checks).
Environment=YTDL_COOKIES_BROWSER=firefox
# NOTE: do NOT force an address family here (e.g. force-ipv6). The pipe
# architecture makes IP-locked URLs a non-issue (yt-dlp fetches everything
# itself), and forcing v6 breaks v4-only CDNs outright (SoundCloud) while
# this host's v6 path to YouTube is flaky. Let yt-dlp pick per connection.
# The user manager's inherited PATH can be minimal; ensure the std bin dirs are present.
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

[Install]
WantedBy=default.target

# Bot token from @BotFather
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# Comma-separated list of allowed Telegram user IDs
# Leave empty to allow everyone
ALLOWED_USERS=418870313

# Local Bot API server URL (optional — for 2GB uploads)
# API_SERVER_URL=http://localhost:8081

# ── Host / runtime config (all optional; defaults shown) ──────────────
# mpv JSON IPC socket
# MPV_SOCKET=/tmp/mpv-socket

# Playlist dirs to scan (os.pathsep-separated; default ~/Videos/{cartoons,movie,shows}/playlists)
# PLAYLIST_DIRS=/home/lad/Videos/cartoons/playlists:/home/lad/Videos/movie/playlists
# Or just point at the Videos root and keep the cartoons/movie/shows layout:
# VIDEOS_DIR=/home/lad/Videos

# mpv launcher (falls back to plain `mpv` if this file is absent)
# MPV_RUNNER=/tmp/mpv-runner.sh

# i3: switch to this workspace before launching mpv (skipped if I3SOCK unset/missing)
# I3SOCK=/run/user/1000/i3/ipc-socket.2012
# I3_WORKSPACE=10

# X11 display for the mpv window
# DISPLAY=:0

# Single-instance lock file (a 2nd instance refuses to start)
# LOCK_FILE=/tmp/tg-mpv-bot.lock

# Auto-scan for newly-added media every N minutes (0 = off; spins up the disk)
# SCAN_INTERVAL_MIN=0

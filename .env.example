# Bot token from @BotFather
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# Comma-separated list of allowed Telegram user IDs (get yours from @userinfobot)
# Leave empty to allow everyone (not recommended — anyone could control your player)
ALLOWED_USERS=123456789

# Local Bot API server (https://github.com/aiogram/telegram-bot-api image) —
# lifts Telegram's 20 MB download cap so sent video files up to 2 GB play.
# Switching a token to a local server requires one-time cloud logout:
#   curl https://api.telegram.org/bot<TOKEN>/logOut
# API_SERVER_URL=http://localhost:8082
# If the server runs with TELEGRAM_LOCAL=true, also set the host path of its
# /var/lib/telegram-bot-api dir (bind-mounted) so the bot can read the files:
# API_LOCAL_FILES_DIR=~/telegram-bot-api-data

# ── Host / runtime config (all optional; defaults shown) ──────────────
# mpv JSON IPC socket
# MPV_SOCKET=/tmp/mpv-socket

# Playlist dirs to scan (os.pathsep-separated; default ~/Videos/{cartoons,movie,shows,tutorials}/playlists)
# PLAYLIST_DIRS=~/Videos/cartoons/playlists:~/Videos/movie/playlists
# Or just point at the Videos root and keep the cartoons/movie/shows layout:
# VIDEOS_DIR=~/Videos

# mpv launcher (falls back to plain `mpv` if this file is absent)
# MPV_RUNNER=/tmp/mpv-runner.sh

# Hooks: shell commands run just before / right after mpv is launched.
# Use them for window-manager glue or notifications — they see
# $PLAYLIST (path), $PLAYLIST_NAME, $MPV_SOCKET and $DISPLAY.
#   i3:    PRE_PLAY_HOOK=i3-msg workspace 10
#   sway:  PRE_PLAY_HOOK=swaymsg workspace 10
#   hypr:  PRE_PLAY_HOOK=hyprctl dispatch workspace 10
#   notify: POST_PLAY_HOOK=notify-send "Now playing" "$PLAYLIST_NAME"
# PRE_PLAY_HOOK=
# POST_PLAY_HOOK=

# X11 display for the mpv window
# DISPLAY=:0

# Before playing, the bot quits its own mpv gracefully over IPC, then pkills
# any stray mpv instances so exactly one player is on screen. Set to 0 if you
# also use mpv manually and don't want the bot killing those.
# KILL_STRAY_MPV=1

# Single-instance lock file (a 2nd instance refuses to start)
# LOCK_FILE=/tmp/tg-mpv-bot.lock

# Where /mpv_last remembers the last-played playlist
# STATE_FILE=~/.local/state/tg-mpv-bot/state.json

# URL playback (send a link to the bot) uses mpv's yt-dlp hook; yt-dlp must
# be installed.
# Browser whose cookies unlock login-gated Instagram/Facebook (applied to
# those hosts only — global cookies make YouTube extraction hang):
# YTDL_COOKIES_BROWSER=firefox
# Extra yt-dlp options applied to every URL (comma-separated key=value).
# This one speeds up YouTube starts a lot (lean single-client extraction);
# remove it first if YouTube playback ever breaks after a YouTube change:
# YTDL_OPTIONS=extractor-args=youtube:player_client=android_vr;player_skip=webpage
# Format selection for URL playback (default caps video at 1080p):
# YTDL_FORMAT=bv*[height<=1080]+ba/b

# Auto-scan for newly-added media every N minutes (0 = off; spins up the disk)
# SCAN_INTERVAL_MIN=0

# Auto-update the venv's yt-dlp nightly every N days (0 = off; recommended 7
# so YouTube extraction fixes arrive before the breakage bites mid-movie)
# YTDL_UPDATE_DAYS=7
